# ---- Supabase ----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never expose to the client. Used by the seed script + admin ops.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI provider selection (server-only) ----
# 글 생성 프로바이더 선택: "openai"(=ChatGPT) | 그 외/미설정 → Claude(기본)
AI_PROVIDER=

# ---- Anthropic (Claude) ----
# Server-only. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxx
# Optional override; defaults to a current Claude model in code.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- OpenAI (ChatGPT) — AI_PROVIDER=openai 일 때 사용 ----
# Server-only. https://platform.openai.com/api-keys
# AI 에이전트 시맨틱 기억검색(임베딩)에도 쓰임 — 미설정 시 최근순 폴백.
OPENAI_API_KEY=
# Optional override; defaults to gpt-4.1 in code.
OPENAI_MODEL=gpt-4.1
# Optional embedding model; defaults to text-embedding-3-small(1536차원).
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Image generation for card news (server-only) ----
# Provider: "pollinations" (free, no key) | "fal" | "gemini".
IMAGE_PROVIDER=pollinations
# fal.ai (FLUX) — https://fal.ai/dashboard/keys (needs funded balance)
FAL_KEY=your-fal-key
FAL_IMAGE_MODEL=fal-ai/flux/schnell
# AI 영상 생성 모델(유료고객 영상 섹터) — fal 영상 모델. 미설정 시 기본값.
FAL_VIDEO_MODEL=fal-ai/ltx-video
# Google Gemini (image gen requires billing) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Cron (server-only) ----
# Vercel Cron이 Authorization: Bearer <CRON_SECRET>로 호출. 예약 발행·오토파일럿 등.
CRON_SECRET=

# ---- Google OAuth (YouTube 연결, server-only) ----
# Google Cloud → OAuth 클라이언트. YouTube Data API v3 + youtube.upload 범위.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 선택: 미설정 시 {SITE_URL}/api/youtube/callback
GOOGLE_OAUTH_REDIRECT=

# ---- Facebook 페이지 연동 (AI 에이전트/오토파일럿 외부 게시, server-only) ----
# Meta 앱 자격증명. pages_manage_posts 권한은 앱 리뷰 승인 필요(승인 전 테스트 페이지만).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# 선택: 미설정 시 {SITE_URL}/api/social/facebook/callback
FACEBOOK_OAUTH_REDIRECT=

# ---- Google Maps 불러오기 (server-only) ----
# 홈페이지 에디터의 "구글 지도에서 불러오기" 기능용.
# Google Cloud Console → API 및 서비스 → "Places API (New)" 사용 설정 후 API 키 발급.
GOOGLE_MAPS_API_KEY=

# ---- Payments: PortOne V2 + Toss Payments ----
# PortOne 콘솔 → 결제 연동 → 연동 정보에서 확인.
# 클라이언트 결제창 호출용 (공개 가능).
NEXT_PUBLIC_PORTONE_STORE_ID=store-00000000-0000-0000-0000-000000000000
# 일반결제(상품 단건 /pay) 채널키.
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-00000000-0000-0000-0000-000000000000
# 정기결제(빌링/구독) 채널키 — 일반결제와 PG 채널이 다를 때 지정.
# 비워두면 위 NEXT_PUBLIC_PORTONE_CHANNEL_KEY로 폴백(단일 채널 환경).
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_BILLING=
# 서버 전용 — 결제 검증/취소 API. 절대 클라이언트에 노출 금지.
PORTONE_API_SECRET=your-portone-v2-api-secret
# PortOne 콘솔 → 웹훅 설정에서 발급 (Standard Webhooks, "whsec_..." 형식).
PORTONE_WEBHOOK_SECRET=whsec_xxxx
