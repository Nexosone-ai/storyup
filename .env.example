# ---- Supabase ----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never expose to the client. Used by the seed script + admin ops.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Anthropic (Claude) ----
# Server-only. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxx
# Optional override; defaults to a current Claude model in code.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Image generation for card news (server-only) ----
# Provider: "pollinations" (free, no key) | "fal" | "gemini".
IMAGE_PROVIDER=pollinations
# fal.ai (FLUX) — https://fal.ai/dashboard/keys (needs funded balance)
FAL_KEY=your-fal-key
FAL_IMAGE_MODEL=fal-ai/flux/schnell
# Google Gemini (image gen requires billing) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Google Maps 불러오기 (server-only) ----
# 홈페이지 에디터의 "구글 지도에서 불러오기" 기능용.
# Google Cloud Console → API 및 서비스 → "Places API (New)" 사용 설정 후 API 키 발급.
GOOGLE_MAPS_API_KEY=

# ---- Naver 지도 불러오기 (server-only) ----
# 홈페이지 에디터의 "지도에서 불러오기"에서 네이버 링크 지원용.
# https://developers.naver.com → 애플리케이션 등록 → 사용 API에 "검색" 추가 후 발급.
# (네이버는 장소 사진 공식 API가 없어 사진은 구글 지도에서만 가져온다.)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---- Payments: PortOne V2 + Toss Payments ----
# PortOne 콘솔 → 결제 연동 → 연동 정보에서 확인.
# 클라이언트 결제창 호출용 (공개 가능).
NEXT_PUBLIC_PORTONE_STORE_ID=store-00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-00000000-0000-0000-0000-000000000000
# 서버 전용 — 결제 검증/취소 API. 절대 클라이언트에 노출 금지.
PORTONE_API_SECRET=your-portone-v2-api-secret
# PortOne 콘솔 → 웹훅 설정에서 발급 (Standard Webhooks, "whsec_..." 형식).
PORTONE_WEBHOOK_SECRET=whsec_xxxx
